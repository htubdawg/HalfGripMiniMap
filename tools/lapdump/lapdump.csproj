<Project Sdk="Microsoft.NET.Sdk">
  <!-- Dumps real ProcTrack laps as CSV for tools/preview. How to run it: see Program.cs. -->
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <LangVersion>10.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <NoWarn>CS0436</NoWarn>
    <ProcTrack Condition="'$(ProcTrack)' == ''">$(MSBuildThisFileDirectory)../../../ProcTrack</ProcTrack>
    <Refs Condition="'$(Refs)' == ''">$(MSBuildThisFileDirectory)../../../halfgriprefs</Refs>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="$(ProcTrack)/ProcTrack/src/Layout.cs;$(ProcTrack)/ProcTrack/src/Rng.cs;Program.cs" />
    <Reference Include="$(Refs)/game/HalfGrip_Data/Managed/UnityEngine.CoreModule.dll" />
  </ItemGroup>
</Project>
